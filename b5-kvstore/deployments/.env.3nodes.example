# Shared environment for the 3-node consensus deployment (default scenario,
# no --profile flag needed — consensus-node-1..3 have no profiles, so they
# always start; see deployments/docker-compose.yml and README.md).
#
# Usage: docker compose --env-file .env.3nodes up -d --build

# Peer list polled by discovery and dialed by every consensus-node (§10.6) —
# must match exactly the consensus-node-N services enabled by this scenario.
PEERS=consensus-node-1:9001,consensus-node-2:9002,consensus-node-3:9003

# Cross-service addressing, resolved via Docker's embedded DNS by service name.
DISCOVERY_ADDR=discovery:8500
SNAPSHOT_ADDR=snapshot-backup:8600

# Week 4 config (client-proxy / discovery) — defaults per README.
DISCOVERY_POLL_INTERVAL_MS=2000
PROXY_REFRESH_INTERVAL_MS=2000
PROXY_RPC_TIMEOUT_MS=2000

# Week 5 config (consensus-node / snapshot-backup) — defaults per README.
SNAPSHOT_POLL_INTERVAL_MS=5000
LOG_CAPACITY_ENTRIES=1000
SNAPSHOT_BACKUP_POLL_INTERVAL_MS=5000
COMPACTION_THRESHOLD_PERCENT=30
COMPACTION_CONCURRENCY_GUARD_PERCENT=90
SNAPSHOT_BACKUP_RPC_TIMEOUT_MS=2000

# Raft election/heartbeat timing (internal/raft/node.go) — defaults per §2.
ELECTION_TIMEOUT_MIN_MS=150
ELECTION_TIMEOUT_MAX_MS=300
HEARTBEAT_INTERVAL_MS=50
