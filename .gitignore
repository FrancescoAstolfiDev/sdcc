# Go build artifacts
*.exe
*.test
*.out
bin/

# Test cache / coverage
*.txt
!README.txt
coverage.out
coverage.html

# Snapshot/debug data generated at runtime — never versioned
*.dat
snapshot-dump.dat
body.json

# Container persistent data (if ever mounted outside Docker volumes)
/data/

# IDE
.vscode/
.idea/

# Environment files (b5-kvstore/deployments/.env, .env.3nodes, .5nodes, .7nodes, etc.)
# — may contain EC2/AWS credentials, never versioned; only the .example templates are tracked
b5-kvstore/deployments/.env
b5-kvstore/deployments/.env.*
!b5-kvstore/deployments/.env.example
!b5-kvstore/deployments/.env.*.example

# AWS credentials
*.pem
*.key
aws-credentials*